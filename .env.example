# =============================================================================
# ClassPilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── LLM Provider (choose ONE free option below) ───────────────────────────────
#
# OPTION 1 — Google Gemini (RECOMMENDED — free, you already have a Google account)
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API key" — no credit card needed
#   3. Paste the key below
#
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash
#
# OPTION 2 — Groq (also free, very fast)
#   1. Go to https://console.groq.com
#   2. Sign up free, get API key — no credit card needed
#   3. Uncomment the three lines below and comment out the Gemini lines above
#
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key-here
# LLM_MODEL=llama-3.1-8b-instant
#
# OPTION 3 — Anthropic Claude (paid, $20 credit needed)
#   Only use this if you specifically want Claude.
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-sonnet-4-6

# ── Watcher ───────────────────────────────────────────────────────────────────
WATCH_INTERVAL_MINUTES=15

# ── State (SQLite — watcher/deadline dedup cache; unrelated to the ────────────
#    Postgres user/credential store below) ──────────────────────────────────
STATE_DB_PATH=classpilot_state.db

# ── Multi-user persistence foundation (Phase 1) ────────────────────────────────
# Postgres holds `users` and their encrypted Google OAuth credentials.
# NOT YET used by the live single-user auth flow (token.json still drives
# that) — this is the storage substrate a later phase's web OAuth flow
# will read/write. See README's "Database setup (Phase 1)" section for
# how to stand up Postgres locally and generate an encryption key.
DATABASE_URL=postgresql://classpilot:classpilot@localhost:5432/classpilot

# Fernet key — the 44-character string from:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts stored Google refresh tokens. Do not commit a real value here.
# Use a DIFFERENT key per environment (dev/staging/prod) — never reuse one.
TOKEN_ENCRYPTION_KEY=

# ── Email Notifications ───────────────────────────────────────────────────────
NOTIFIER_BACKEND=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_TO_EMAIL=yourname@gmail.com

# ── HTTP MCP Transport (for remote clients e.g. ChatGPT) ────────────────────────
# Only needed when running: classpilot-ai-http
# Default binds to localhost only — safe for local use.
# Set MCP_HTTP_HOST=0.0.0.0 to allow remote access (use behind TLS proxy).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Google OAuth (for Classroom + Drive access) ───────────────────────────────
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
