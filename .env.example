# =============================================================================
# ClassPilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🛑 SECRETS
# In production, these MUST be stored securely in your deployment platform's
# secret manager (e.g. Render, AWS, GCP) or injected via secure environment variables.
# NEVER commit real values for these.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Database Connection (PostgreSQL / Neon)
# Standard PostgreSQL URI with TLS enabled.
# Example: postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/classpilot?sslmode=require
DATABASE_URL=

# 2. Token Encryption Key
# Fernet key (44-character urlsafe base64 string) used to encrypt stored Google OAuth refresh tokens at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# 3. LLM API Key (Google Gemini, Groq, or Anthropic)
# Required by configuration validation for AI helper operations.
LLM_API_KEY=your-api-key-here

# 4. Google OAuth Web Client Credentials (JSON File)
# Downloaded from Google Cloud Console (OAuth 2.0 Client IDs -> Web application).
# Points to the credentials file on disk.
GOOGLE_WEB_CREDENTIALS_PATH=google_web_credentials.json


# ─────────────────────────────────────────────────────────────────────────────
# 🟢 NON-SECRETS / APPLICATION CONFIGURATION
# Safe configuration values that govern server runtime behavior.
# ─────────────────────────────────────────────────────────────────────────────

# --- LLM Provider Settings ---
# Options: gemini (recommended free tier), groq (free fast inference), anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite

# --- Database Connection Pool ---
# Min and Max connections for PostgreSQL connection pooling (psycopg-pool).
# Recommended: min 0, max 5 for serverless containers to avoid holding idle connections.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=5

# --- Authentication & Network ---
# In production, MCP_AUTH_MODE MUST be 'remote' (enforces OAuth 2.1 + PKCE on all tool calls).
# Use 'local_dev' only for local stdio debugging with CLASSPILOT_DEV_USER_ID.
MCP_AUTH_MODE=remote

# The public HTTPS base URL where this server is accessible.
# Used for OAuth 2.1 discovery (RFC 8414) and client audience binding (RFC 8707 / RFC 9728).
# Example: https://classpilot-ai.onrender.com or http://localhost:8000
MCP_PUBLIC_BASE_URL=https://your-domain.onrender.com

# Google OAuth 2.0 Redirect URI (must match the URI registered in Google Cloud Console).
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.onrender.com/auth/google/callback

# Lifetime of ClassPilot-issued MCP access tokens in seconds (default: 3600 = 1 hour).
MCP_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Server Transport & Binding ---
# Host and port for Streamable HTTP transport (classpilot-ai-http).
# Note: In environments where the PORT environment variable is set (such as Render),
# the host automatically defaults to 0.0.0.0 and port binds to $PORT.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local Development Fallback (Optional) ---
# Used ONLY when MCP_AUTH_MODE=local_dev for local testing without an OAuth client.
# Ignored and strictly rejected when running in production.
# CLASSPILOT_DEV_USER_ID=
