# =============================================================================
# ClassPilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🛑 SECRETS
# In production (Cloud Run), these MUST be stored securely in Secret Manager
# or as secure environment variables. NEVER commit real values for these.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Database Connection (Neon PostgreSQL)
# Example: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 2. Token Encryption Key
# Fernet key (44-char urlsafe-base64 string) for at-rest token encryption.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# 3. LLM API Key (Anthropic, Gemini, or Groq)
LLM_API_KEY=your-api-key-here

# 4. Email Notification Password (if using SMTP)
SMTP_PASSWORD=

# 5. Google OAuth Web Credentials (JSON file)
# In production, mount this file as a volume via Secret Manager.
# The path itself is not a secret, but it points to secret material.
GOOGLE_WEB_CREDENTIALS_PATH=google_web_credentials.json


# ─────────────────────────────────────────────────────────────────────────────
# 🟢 NON-SECRETS
# These are safe configuration values that control application behavior.
# ─────────────────────────────────────────────────────────────────────────────

# --- LLM Provider Settings ---
# Options: anthropic, gemini, groq
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Database Connection Pool ---
# Min and Max size for PostgreSQL connections.
# Use 0/5 for Cloud Run to drop connections when instances suspend.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=5

# --- Authentication & Network ---
# In production, MCP_AUTH_MODE MUST be 'remote'.
MCP_AUTH_MODE=remote

# The public URL this server is reachable at (used for OAuth discovery).
MCP_PUBLIC_BASE_URL=https://your-cloud-run-url.run.app

# Google OAuth redirect URI (must match Google Cloud Console).
GOOGLE_OAUTH_REDIRECT_URI=https://your-cloud-run-url.run.app/auth/google/callback

# --- Watcher ---
WATCH_INTERVAL_MINUTES=15

# --- Email Notifications ---
NOTIFIER_BACKEND=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
NOTIFY_TO_EMAIL=yourname@gmail.com

