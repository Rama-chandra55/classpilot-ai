# =============================================================================
# ClassPilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── LLM Provider (choose ONE free option below) ───────────────────────────────
#
# OPTION 1 — Google Gemini (RECOMMENDED — free, you already have a Google account)
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API key" — no credit card needed
#   3. Paste the key below
#
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash
#
# OPTION 2 — Groq (also free, very fast)
#   1. Go to https://console.groq.com
#   2. Sign up free, get API key — no credit card needed
#   3. Uncomment the three lines below and comment out the Gemini lines above
#
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key-here
# LLM_MODEL=llama-3.1-8b-instant
#
# OPTION 3 — Anthropic Claude (paid, $20 credit needed)
#   Only use this if you specifically want Claude.
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-sonnet-4-6

# ── Watcher ───────────────────────────────────────────────────────────────────
WATCH_INTERVAL_MINUTES=15

# ── State ─────────────────────────────────────────────────────────────────────
STATE_DB_PATH=classpilot_state.db

# ── Email Notifications ───────────────────────────────────────────────────────
NOTIFIER_BACKEND=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_TO_EMAIL=yourname@gmail.com

# ── HTTP MCP Transport (for remote clients e.g. ChatGPT) ────────────────────────
# Only needed when running: classpilot-ai-http
# Default binds to localhost only — safe for local use.
# Set MCP_HTTP_HOST=0.0.0.0 to allow remote access (use behind TLS proxy).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Google OAuth (for Classroom + Drive access) ───────────────────────────────
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
